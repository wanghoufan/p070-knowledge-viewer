<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f9f7">

    <WebView
        android:id="@+id/slide_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/slide_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#ffffff"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/slide_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/slide_button"
            android:textColor="#10231c" />

        <TextView
            android:id="@+id/slide_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="16sp"
            android:textColor="#10231c" />

        <Button
            android:id="@+id/slide_full"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="76dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/slide_button"
            android:textColor="#10231c" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slide_bottombar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#ffffff"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/slide_prev"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:textSize="24sp"
            android:text="‹"
            android:textAllCaps="false"
            android:background="@drawable/slide_button"
            android:textColor="#10231c" />

        <TextView
            android:id="@+id/slide_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#23362e" />

        <Button
            android:id="@+id/slide_next"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:textSize="24sp"
            android:text="›"
            android:textAllCaps="false"
            android:background="@drawable/slide_button"
            android:textColor="#10231c" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slide_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:background="#f7f9f7">

        <TextView
            android:id="@+id/slide_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#10231c" />

        <TextView
            android:id="@+id/slide_error_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#718278" />

        <Button
            android:id="@+id/slide_error_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/slide_button_primary"
            android:textColor="#ffffff" />
    </LinearLayout>
</FrameLayout>
